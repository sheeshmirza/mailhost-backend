# ==============================================================================
# MAILHOST LOCAL DOCKER RUNNING SERVICES CONFIGURATION
# ==============================================================================
# This template is pre-configured to connect directly to local Docker container
# services running on localhost (PostgreSQL, Redis, RabbitMQ, MongoDB, Qdrant).
#
# Quickstart:
#   cp .env.example .env
#   go run main.go
# ==============================================================================

# ------------------------------------------------------------------------------
# Core Identity & Hostname
# ------------------------------------------------------------------------------
# FQDN of your local mail server instance.
# Announced in SMTP EHLO/HELO greetings and used as the base tracking link URL.
HOSTNAME=localhost

# Optional override: MAIL_HOSTNAME takes precedence over HOSTNAME when set.
MAIL_HOSTNAME=localhost

# ------------------------------------------------------------------------------
# Cluster Roles (Default: all)
# ------------------------------------------------------------------------------
# Comma-separated list of execution roles run by this process:
#   - api:     Serves HTTP REST API, MCP JSON-RPC, tracking, and webhooks
#   - smtp:    Listens on SMTP ports for inbound MX and authenticated submission
#   - worker:  Consumes outbound delivery queues and handles direct MX dispatch
#   - imap:    Listens on IMAP port for mailbox folder and message reading
#   - pop:     Listens on POP3 port for mailbox message retrieval and deletion
#   - all:     Enables all 5 roles concurrently in a single binary process
ROLES=all

# ------------------------------------------------------------------------------
# Network Bind Addresses (Local Development Friendly)
# ------------------------------------------------------------------------------
# HTTP REST API listening address.
# (Set to :8081 if port :8080 is already occupied by local containers like SearXNG)
HTTP_ADDR=:8081

# Inbound MX SMTP listening address.
# Use :2525 for non-root local testing, or :25 if running with root/CAP_NET_BIND_SERVICE.
SMTP_ADDR=:2525

# Authenticated SMTP Client Submission listening address (e.g. :587 or :5870).
SUBMISSION_ADDR=:5870

# IMAP4rev1 Mailbox Retrieval listening address (e.g. :143 or :1143).
IMAP_ADDR=:1143

# POP3 Mailbox Retrieval listening address (e.g. :110 or :1110).
POP3_ADDR=:1110

# Go runtime diagnostic pprof and metrics endpoint
DEBUG_ADDR=127.0.0.1:6060

# ------------------------------------------------------------------------------
# Cryptographic Master Key (REQUIRED)
# ------------------------------------------------------------------------------
# 32-byte secret key encoded as exactly 64 hexadecimal characters.
# Used for:
#   - XSalsa20-Poly1305 authenticated symmetric encryption of domain DKIM private keys
#   - Encryption of webhook signing secrets at rest
#   - HMAC-SHA256 signature verification for open/click tracking URLs
# (Below is a pre-generated valid 64-hex key for immediate local execution)
MASTER_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# ------------------------------------------------------------------------------
# Primary Relational Database - PostgreSQL (Local Docker Container)
# ------------------------------------------------------------------------------
# Connects to your local running PostgreSQL Docker container (my-postgres on port 5432).
# Supports user 'postgres' with trust authentication and sslmode disabled for local development.
DATABASE_URL=postgres://postgres@localhost:5432/mailhost?sslmode=disable

# Optional Read Replica URL (leave blank for single local PostgreSQL instance)
DATABASE_READ_URL=

# Maximum number of concurrent connections in the PostgreSQL connection pool.
DB_MAX_CONNS=20

# Event table partition retention in months (0 = retain forever).
RETENTION_MONTHS=12

# ------------------------------------------------------------------------------
# Distributed Cache & Rate Limiting - Redis (Local Docker Container)
# ------------------------------------------------------------------------------
# Connects to your local running Redis Docker container (my-redis on port 6379).
# Used for distributed token-bucket rate limiting, token revocations, and caching.
REDIS_URL=redis://localhost:6379/0

# ------------------------------------------------------------------------------
# Outbound Message Queue Broker - RabbitMQ (Local Docker Container)
# ------------------------------------------------------------------------------
# Connects to your local running RabbitMQ Docker container (my-rabbitmq on port 5672).
# Uses default guest credentials (guest:guest). Management UI available at http://localhost:15672.
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# ------------------------------------------------------------------------------
# Document & Payload Store - MongoDB (Local Docker Container)
# ------------------------------------------------------------------------------
# Connects to your local running MongoDB Docker container (my-mongo on port 27017).
# Used for storing raw RFC 5322 MIME payloads, large bodies, and attachments.
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=mailhost

# ------------------------------------------------------------------------------
# Vector Database - Qdrant (Local Docker Container)
# ------------------------------------------------------------------------------
# Connects to your local running Qdrant Docker container (my-qdrant on port 6333).
# Powers AI semantic vector search over transactional emails and rich HTML templates.
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_PREFIX=mailhost

# ------------------------------------------------------------------------------
# TLS / SSL Certificates (Optional for Local Development)
# ------------------------------------------------------------------------------
# Leave blank to run local HTTP and plaintext/STARTTLS bypass for local testing.
# In production, provide paths to valid PEM-encoded certificate chain and key.
TLS_CERT_FILE=
TLS_KEY_FILE=

# ------------------------------------------------------------------------------
# Outbound SMTP Direct MX Delivery Engine
# ------------------------------------------------------------------------------
# Number of parallel outbound delivery worker goroutines
WORKERS=4

# Idle queue polling interval when no jobs are active
POLL_INTERVAL=1s

# Maximum delivery retry attempts before marking email as permanently failed
MAX_ATTEMPTS=5

# Maximum concurrent outbound SMTP connections to any single remote host
MAX_CONNS_PER_HOST=5

# Outbound delivery rate limit per remote destination host (0 to disable)
DEST_RATE_LIMIT_RPS=0
DEST_RATE_LIMIT_BURST=0

# Destination TCP port for direct outbound MX delivery
OUTBOUND_SMTP_PORT=25

# Allow delivery to private IP networks (127.0.0.1, RFC 1918).
# Set to 'true' for local testing against Mailpit/local SMTP receivers.
ALLOW_PRIVATE_DELIVERY=true

# Development only: mark domain DNS records verified without public DNS resolution.
# Set to 'true' for local development so test domains can be verified instantly.
SKIP_DNS_VERIFICATION=true

# Custom upstream DNS resolver (leave blank to use system /etc/resolv.conf)
DNS_SERVER=

# ------------------------------------------------------------------------------
# Security, Limits & Proxy Trust
# ------------------------------------------------------------------------------
# Maximum acceptable message payload size in bytes (default: 25 MiB)
MAX_MESSAGE_BYTES=26214400

# Global API rate limit per API key (requests per second and burst capacity; 0 = unlimited)
RATE_LIMIT_RPS=0
RATE_LIMIT_BURST=0

# TTL for API Idempotency-Key header deduplication records
IDEMPOTENCY_TTL=24h

# Fraction of successful HTTP requests logged to stdout (1.0 = 100%)
ACCESS_LOG_SAMPLE=1.0

# Trusted reverse proxy CIDR blocks for X-Forwarded-For resolution
TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128

# ------------------------------------------------------------------------------
# System Senders & Authentication Emails (Optional)
# ------------------------------------------------------------------------------
# External SMTP configuration for sending account verification and reset emails.
# Leave blank to disable external authentication email delivery during local testing.
AUTH_EMAIL_SMTP_ADDR=
AUTH_EMAIL_SMTP_USERNAME=
AUTH_EMAIL_SMTP_PASSWORD=
AUTH_EMAIL_FROM=

# ------------------------------------------------------------------------------
# Support & AI Integrations
# ------------------------------------------------------------------------------
# Support email displayed in API error responses
SUPPORT_EMAIL=support@localhost

# Optional bearer token for OpenAI ChatGPT Plugin / MCP Action authentication
OPENAI_PLUGIN_TOKEN=
